# ---------------------------------------------------------------------------
# BillEasy — environment configuration
# Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Database — MongoDB Atlas connection string, or local: mongodb://127.0.0.1:27017/billeasy
MONGODB_URI=

# NextAuth v5 (auth) — generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# E-invoice (IRN) generation
#   stub     = default; real IRN hash + NIC payload, QR NOT IRP-signed (no creds needed)
#   cleartax = live via ClearTax GSP (genuinely IRP-signed) — fill CLEARTAX_* below
#   rest     = generic single-POST GSP relay — fill GSP_* below
# See docs/cleartax-einvoice-setup.md for how to obtain ClearTax credentials.
# ---------------------------------------------------------------------------
EINVOICE_MODE=stub

# Seller GSTIN sent to the GSP (prototype uses the demo seller's GSTIN)
SELLER_GSTIN=33AAPFU0939F1ZV

# --- ClearTax (EINVOICE_MODE=cleartax) ---
CLEARTAX_BASE_URL=
CLEARTAX_OWNER_ID=
CLEARTAX_GSP_APP_ID=
CLEARTAX_GSP_APP_SECRET=
# Optional path overrides. Defaults: /einv-gsp/vital/v1.04/auth and /einv-gsp/core/v1.03/Invoice
CLEARTAX_AUTH_PATH=
CLEARTAX_IRN_PATH=

# --- Generic GSP (EINVOICE_MODE=rest) ---
GSP_BASE_URL=
GSP_API_KEY=
GSP_API_SECRET=

# ---------------------------------------------------------------------------
# Razorpay subscriptions (annual plans + 14-day trial)
#   Leave KEY_ID/SECRET blank = MOCK mode (subscribe activates instantly, no charge).
#   Set them = LIVE mode (creates a real Razorpay subscription; needs the Plan IDs + webhook).
# See docs/razorpay-setup.md.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan IDs (create one annual Plan per tier in the dashboard):
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_BUSINESS=
